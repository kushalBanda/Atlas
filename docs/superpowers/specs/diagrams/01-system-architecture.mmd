    REG --- MN
  end

  subgraph L4["Storage layer — pkg/storage"]
    IFACE[Storage interface]
    IMPL[(embedded columnar store)]
    IFACE --- IMPL
  end

  subgraph L5["Analysis layer — pkg/rootcause"]
    ANALYZE[Trace-tree analyzer<br/>runs on trace close]
  end

  subgraph L6["Access layer"]
    API[pkg/api — routing]
    QRY[pkg/query — read interface]
  end

  UI[Presentation — any client]

  L0 -->|emits spans, tagged with trace context| L2
  L1 -->|registers collection targets against| L2
  L2 -->|dispatches by schema to| L3
  L3 -->|writes through| L4
  L4 -->|closed trace triggers| L5
  L5 -->|writes derived verdict back to| L4
  L4 -->|reads via| L6
  API --> QRY
  L6 --> UI
