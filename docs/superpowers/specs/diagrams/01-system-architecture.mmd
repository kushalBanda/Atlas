flowchart TD
  classDef pad fill:none,stroke:none,color:transparent
  subgraph L0["Instrumented process layer"]
    direction TB
    S1[Source]
    S2[Source]
    SN[Source ...N]
  end

  subgraph L1["Control plane — pkg/discovery"]
    direction LR
    DISC[Discoverer interface]
    R1[implementation: process/port]
    R2[implementation: container runtime]
    R3[implementation: orchestrator API]
    DISC --- R1
    DISC --- R2
    DISC --- R3
  end

  subgraph L2["Ingest layer — pkg/ingest"]
    RECV[Protocol receiver<br/>OTLP + W3C trace context]
  end

  subgraph L3["Extension layer — pkg/plugin"]
    REG[Module registry interface]
    M1[registered module: core signals]
    MN[registered module: domain-specific signals]
